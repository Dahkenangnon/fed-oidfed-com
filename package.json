{
  "name": "fed-oidfed-com",
  "version": "0.1.0",
  "private": true,
  "description": "Reference implementation of OpenID Federation 1.0 — six topologies built on @oidfed/core, @oidfed/authority, @oidfed/leaf, and @oidfed/oidc. Hono for federation-only entities, Express + node-oidc-provider for OPs, vhost-dispatched from one Node HTTP server.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src test",
    "format": "biome format --write src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy": "pnpm install --prod=false && pnpm build && pm2 startOrReload ecosystem.config.cjs --env production"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@oidfed/authority": "^0.5.0",
    "@oidfed/core": "^0.5.0",
    "@oidfed/leaf": "^0.5.0",
    "@oidfed/oidc": "^0.5.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "hono": "^4.6.14",
    "jose": "^6.2.0",
    "oidc-provider": "^9.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/oidc-provider": "^9.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "overrides": {
      "@oidfed/core": "^0.5.0"
    }
  }
}
